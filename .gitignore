__pycache__/
*.pyc
*.pyo
.venv/
venv/
.idea/
.vscode/
*.egg-info/
build/
dist/
.pytest_cache/
.pytest_tmp/
.ruff_cache/
.mypy_cache/
.hypothesis/

# ── Local secrets & settings (never commit) ───────────────────────────────────
.env
.env.*
config/settings.json
config/settings.local.json
config/settings.json.backup-*
config/settings.json.corrupted-*
config/*.bak
config/license_client.json
config/exception_state.json
config/secret.key
*.pem
!pa_agent/licensing/public_key.pem
*.key
tools/.license_keys/

# ── Runtime artifacts ─────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep

records/**/*
!records/**/.gitkeep

experience/**/*
!experience/**/.gitkeep

# ── Local agent / editor tooling (not part of the app) ────────────────────────
.workbuddy/
.claude/worktrees/

# ── OS / editor ───────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
